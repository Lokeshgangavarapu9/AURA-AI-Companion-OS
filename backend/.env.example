# ============================================================
# SERVER & DATABASE CONFIGURATION (NEON POSTGRESQL)
# ============================================================
NODE_ENV=production
PORT=5000

# Neon PostgreSQL connection string (direct or pooled)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Production secrets (minimum 16 characters required)
JWT_SECRET="aura_super_secret_jwt_key_2026_production_grade"
SESSION_SECRET="aura_super_secret_session_key_2026_production_grade"

# ============================================================
# AI PROVIDER CONFIGURATION
# ============================================================

USE_PROVIDER_ABSTRACTION=true

ACTIVE_AI_PROVIDER=gemini

ACTIVE_AI_MODEL=gemini-2.5-flash

# ============================================================
# GOOGLE GEMINI
# ============================================================

GEMINI_API_KEY=

# ============================================================
# OPENAI
# ============================================================

OPENAI_API_KEY=

# ============================================================
# GROQ
# ============================================================

GROQ_API_KEY=

# ============================================================
# OPENROUTER
# ============================================================

OPENROUTER_API_KEY=

# ============================================================
# CEREBRAS
# ============================================================

CEREBRAS_API_KEY=

# ============================================================
# HUGGING FACE
# ============================================================

HUGGINGFACE_API_KEY=

# ============================================================
# TOGETHER AI
# ============================================================

TOGETHER_API_KEY=

# ============================================================
# AI SETTINGS
# ============================================================

AI_TEMPERATURE=0.8

AI_MAX_TOKENS=4096

AI_TIMEOUT_MS=30000

AI_MAX_RETRIES=3

AI_STREAMING=true

# ============================================================
# VOICE
# ============================================================

VOICE_STT_PROVIDER=google

VOICE_TTS_PROVIDER=google

VOICE_LANGUAGE=en-US

VOICE_NAME=en-US-Neural2-F

VOICE_RATE=1.0

VOICE_PITCH=0

VOICE_VOLUME=1.0

VOICE_AUDIO_FORMAT=MP3

VOICE_INTERIM_RESULTS=true

VOICE_AUTO_PUNCTUATION=true

VOICE_CONFIDENCE_THRESHOLD=0.70

VOICE_STREAMING=true

VOICE_TIMEOUT_MS=30000

# ============================================================
# CAMERA / VISION
# ============================================================

VISION_ENABLED=true

VISION_PROVIDER=google
