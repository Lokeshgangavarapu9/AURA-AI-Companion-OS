# ============================================================
# AURA AI COMPANION OS — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# Backend / Railway Environment Variables:
NODE_ENV=production
PORT=5000

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth Secrets (minimum 16 characters)
JWT_SECRET="aura_super_secret_jwt_key_2026_production_grade"
SESSION_SECRET="aura_super_secret_session_key_2026_production_grade"

# AI Provider Configuration
ACTIVE_AI_PROVIDER=gemini
ACTIVE_AI_MODEL=gemini-2.5-flash
USE_PROVIDER_ABSTRACTION=true
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Frontend / Vercel Environment Variables:
# VITE_API_URL="https://your-aura-backend.up.railway.app/api/v1"
# VITE_WS_URL="wss://your-aura-backend.up.railway.app/ws/voice"
